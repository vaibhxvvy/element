import { VerticalBox, ListView } from "std-widgets.slint";

export struct ResultItem {
    title: string,
    subtitle: string,
    kind: string,
    icon: image,
}

export component SearchWindow inherits Window {
    in-out property <string> input-text;
    in-out property <[ResultItem]> results;
    in-out property <int> selected-index: -1;
    in-out property <int> result-count: 0;

    callback input-changed(string);
    callback item-selected(int);
    callback request-hide();
    callback navigate-up();
    callback navigate-down();

    background: #151518;
    no-frame: true;
    always-on-top: true;
    title: "Element";
    width: 580px;
    min-height: 60px;

    VerticalBox {
        padding: 0;
        spacing: 0;

        Rectangle {
            min-height: 48px;
            background: #1A1A1E;
            border-radius: 0px;

            Text {
                x: 16px;
                y: (parent.height - self.height) / 2;
                visible: input-text == "";
                color: #555566;
                font-size: 14px;
                letter-spacing: 0.3px;
                text: "Search apps, files, or type anything...";
            }

            TextInput {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                color: #F5F3FA;
                font-size: 14px;
                font-weight: 400;
                letter-spacing: 0.2px;
                text <=> input-text;
                edited => { input-changed(self.text); }
                accepted => { if (selected-index >= 0) { item-selected(selected-index); } }
            }
        }

        Rectangle {
            height: 1px;
            background: #222228;
        }

        ListView {
            visible: results.length > 0;
            for item[idx] in results: Rectangle {
                height: 42px;
                background: idx == selected-index ? #25252D : transparent;

                Rectangle {
                    width: 3px;
                    height: parent.height;
                    x: 0;
                    background: idx == selected-index ? #7C5CFC : transparent;
                }

                TouchArea {
                    clicked => { item-selected(idx); }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        alignment: start;

                        Image {
                            width: 20px;
                            height: 20px;
                            source: item.icon;
                            y: (parent.height - self.height) / 2;
                        }

                        VerticalLayout {
                            spacing: 1px;
                            Text {
                                text: item.title;
                                color: #F5F3FA;
                                font-size: 13px;
                                font-weight: 500;
                                letter-spacing: 0.2px;
                                vertical-alignment: center;
                                min-height: 20px;
                            }
                            Text {
                                text: item.subtitle;
                                color: #777788;
                                font-size: 11px;
                                letter-spacing: 0.2px;
                                vertical-alignment: center;
                                min-height: 16px;
                            }
                        }
                    }
                }
            }
        }
    }
}
